FMS_ENV=development
FMS_ENVIRONMENT_ID=care-move-fms-local
FMS_LEASE_SECRET=replace-with-a-new-local-secret
FMS_DATABASE_URL=sqlite:///./data/fms.sqlite3
FMS_ROS_DOMAIN_ID=73
# Task 전달 기본값. ssh는 명시적 legacy이며 Topic 실패 시 자동으로 바뀌지 않습니다.
FMS_FLEET_DISPATCH_MODE=ros_topic
# Optional overrides. Defaults = Nav2 footprint circumradius + 0.01 m (~0.09485).
# FMS_PLANNING_RESOLUTION_M=0.0948528137423857
# FMS_PLANNING_ROBOT_RADIUS_M=0.0948528137423857
# Auto-seed via /initialpose after AMCL+map match when no live localization.
# Registered XY/yaw default from config/maps/physical_site/nav2_params.yaml.
# FMS_PHYSICAL_INITIAL_POSE_AUTO=true
# FMS_PHYSICAL_INITIAL_POSE_TOPIC=/initialpose
# FMS_PHYSICAL_INITIAL_POSE_MAX_ATTEMPTS=3
# FMS_PHYSICAL_INITIAL_POSE_RETRY_S=12
FMS_API_HOST=0.0.0.0
FMS_API_PORT=8741
FMS_PHYSICAL_CONTROL_ENABLED=false
FMS_ROS_BRIDGE_ENABLED=false
FMS_AUTO_TICK=true
FMS_SEED_FLEET=true
